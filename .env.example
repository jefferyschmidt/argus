# Copy to .env and fill in. .env is gitignored — never commit real keys.

ANTHROPIC_API_KEY=

# Optional native speech-to-speech voice mode. Set VOICE_MODE=realtime to
# use it; it is conversational-only, while the normal pipeline mode retains
# Argus's desktop tools. Requires the voice dependency's websockets package.
OPENAI_API_KEY=
VOICE_MODE=pipeline
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin

# Optional -- console log verbosity. Set to INFO for a debug session to see
# real-time detail (wake-word detections, tool calls, turn failures) in the
# terminal instead of only in data/argus.log. Default: WARNING.
CONSOLE_LOG_LEVEL=WARNING

# Ollama server (defaults to local install) -- kept as the genuine offline
# fallback (no internet needed) even when GROQ_API_KEY below is set.
OLLAMA_HOST=http://localhost:11434
OLLAMA_LOCAL_MODEL=llama3.2:3b

# Optional -- if set, Groq replaces Ollama in the low-latency "local" slot
# (small talk, addressee-gate classification): free, hosted, no cold start.
# Get a key at https://console.groq.com/keys -- Groq's model lineup changes
# over time, check `console.groq.com/docs/models` for what's current if
# GROQ_MODEL below 404s. It's a reasoning model, so GroqClient always
# passes reasoning_effort='low' -- swapping to a different model may need
# that adjusted in groq_client.py if it doesn't support that parameter.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Same GROQ_API_KEY also switches speech-to-text to Groq's hosted Whisper
# (replacing local faster-whisper, same cold-CPU motivation). Local
# faster-whisper stays as the automatic fallback if Groq is unreachable.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Default Anthropic model for the "frontier" tier
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_ADVANCED_MODEL=claude-sonnet-5

# SQLite + Chroma paths (relative to project root)
ARGUS_DATA_DIR=data

# Optional -- grounds location-dependent questions (weather, "near me")
USER_LOCATION=

# Set to false if voice replies stall/go silent -- barge-in runs continuous
# wake-word inference concurrently with speech, which can starve the CPU
# on weaker/CPU-only hardware.
VOICE_BARGE_IN_ENABLED=true

# STT language -- leave blank to auto-detect (needed for on-the-fly
# translation of non-English speech). Pin to a code like "en" if
# auto-detection ever misfires on short commands.
STT_LANGUAGE=

# How long after Argus stops talking it keeps listening without needing
# the wake word again -- renews with each follow-up thing you say, so
# it's "seconds since the last thing said," not a hard per-turn cap.
FOLLOWUP_WINDOW_SECONDS=30

# Optional -- if set, Cartesia is used for TTS (much more natural than
# Piper) with automatic fallback to Piper if unset/unreachable/erroring.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=ef191366-f52f-447a-a398-ed8c0f2943a1  # Archie, warm conversational British male
CARTESIA_MODEL=sonic-3

# Optional -- remote access via Telegram (only active in `argus voice`).
# Create a bot with @BotFather to get a token, then message your new bot
# once and check https://api.telegram.org/bot<token>/getUpdates to find
# your own numeric chat ID. Both must be set -- without the allowlisted
# chat ID, the bridge stays off rather than accepting commands from anyone
# who finds the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Optional -- email monitoring (IMAP, only active in `argus voice`). Needs
# an app-specific password from each account, NOT your real password --
# Gmail: https://myaccount.google.com/apppasswords
# Yahoo: https://login.yahoo.com/myaccount/security -> "Generate app password"
# Leave either account's two lines blank to skip it entirely.
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
YAHOO_IMAP_USER=
YAHOO_IMAP_APP_PASSWORD=
EMAIL_WATCH_POLL_SECONDS=120

# Optional -- Google Calendar via the real API (not browser automation).
# From Google Cloud Console: enable the Calendar API, then Credentials ->
# Create Credentials -> OAuth client ID -> Application type: Desktop app.
# After setting these, run `argus calendar auth` once (opens a browser for
# consent) -- never prompts again after that.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional -- second-brain ingestion. Point this at a folder and any
# PDF/txt/md dropped in it gets auto-read into long-term memory (also
# available on-demand via the ingest_document tool regardless of this).
KNOWLEDGE_WATCH_FOLDER=
KNOWLEDGE_WATCH_POLL_SECONDS=60

# Optional -- web tasks (navigate, click, fill forms) via Playwright's MCP
# server, using structured accessibility data instead of screenshot-and-
# guess desktop control. Requires Node/npx on PATH (the server itself is
# fetched automatically via `npx -y @playwright/mcp@latest` on first use,
# no separate install step). Off by default: launching it spawns a real
# browser process and adds a few seconds to startup, not worth paying for
# a capability most turns never use. Install with the `mcp` extra:
# pip install -e ".[mcp]"
ENABLE_PLAYWRIGHT_MCP=false

# Optional -- Zapier's MCP server (9,000+ app actions -- Slack, Notion,
# Trello, etc.). Get your account's MCP server URL from Zapier's own MCP
# integration setup; paste it whole below (it's account-specific). The
# API key is only needed if that URL doesn't already embed its own auth.
ZAPIER_MCP_URL=
ZAPIER_MCP_API_KEY=

# Optional -- Home Assistant smart home control (lights, thermostat,
# locks, scenes) via its official "MCP Server" integration. Enable it in
# HA: Settings -> Integrations -> Add Integration -> MCP Server, then use
# <your-ha-url>/mcp_server/sse below. Token is a long-lived access token
# from your HA profile page.
HOME_ASSISTANT_MCP_URL=
HOME_ASSISTANT_MCP_TOKEN=

# Optional -- GitHub's official remote MCP server (issues, PRs, repo
# management -- complements the existing local self-editing tools, doesn't
# replace them). Fixed endpoint, no URL to paste in -- just enable it and
# supply a personal access token from https://github.com/settings/tokens.
ENABLE_GITHUB_MCP=false
GITHUB_MCP_TOKEN=

# Optional -- Figma's Dev Mode MCP server. Runs locally inside the Figma
# desktop app itself (Dev Mode -> Enable desktop MCP server in the
# inspect panel) -- no account/token needed, but the desktop app has to
# actually be running with a file open in Dev Mode for this to connect.
ENABLE_FIGMA_MCP=false
